{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build project",
			"type": "shell",
			"command": "npm run build",
			"isBackground": false,
			"problemMatcher": ["$tsc"],
			"group": "build"
		},
		{
			"label": "Build project (bypass policy)",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -Command \"npm run build\"",
			"isBackground": false,
			"problemMatcher": ["$tsc"],
			"group": "build"
		},
		{
			"label": "Run project tests",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -Command \"npm test\"",
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Build backend bundle",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -Command \"npm run build:backend\"",
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}