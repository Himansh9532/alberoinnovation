rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /skillaiPlans/{userId} {
      allow read, write: if false;
    }
    match /razorpayOrders/{orderId} {
      allow read, write: if false;
    }
    match /razorpayPayments/{paymentId} {
      allow read, write: if false;
    }
  }
}
